# No API key needed: the Claude Agent SDK uses your Claude Code login (Pro/Max plan).
# Run `claude` once and `/login` if you haven't. Do NOT set ANTHROPIC_API_KEY,
# or the SDK will bill the API instead of your plan.
MODEL_DEFAULT=sonnet
MODEL_FAST=haiku
# Folders Nora scans for projects (read-only), separated by ':'.
PROJECTS_ROOTS=~/Agents/Coding:~/Agents:~
